{
 "vo": [
  {
   "id": "r01",
   "start": 0.4,
   "end": 5.574,
   "cap": "En *1859*, un homme relâche *24 lapins* en Australie."
  },
  {
   "id": "r02",
   "start": 5.924,
   "end": 9.218,
   "cap": "Aujourd'hui, ils sont environ *200 millions*."
  },
  {
   "id": "r03",
   "start": 9.718,
   "end": 14.206,
   "cap": "Voici comment *24 lapins* ont envahi tout un *continent*."
  },
  {
   "id": "r04",
   "start": 14.906,
   "end": 20.414,
   "cap": "*Thomas Austin* est un colon anglais, installé près de *Geelong*, dans le sud de l'Australie."
  },
  {
   "id": "r05",
   "start": 20.914,
   "end": 25.695,
   "cap": "Il veut chasser comme en *Angleterre*… alors il fait venir des lapins d'*Europe*."
  },
  {
   "id": "r06",
   "start": 26.495,
   "end": 33.246,
   "cap": "Le jour de *Noël 1859*, *24 lapins* arrivent sur sa propriété."
  },
  {
   "id": "r07",
   "start": 33.696,
   "end": 37.919,
   "cap": "Six ans plus tard, il en a déjà tué *20 000* sur ses terres."
  },
  {
   "id": "r08",
   "start": 38.419,
   "end": 45.738,
   "cap": "Car en Australie, le lapin n'a presque *aucun prédateur*… et une lapine peut avoir *plusieurs dizaines* de petits par an."
  },
  {
   "id": "r09",
   "start": 46.338,
   "end": 53.161,
   "cap": "Ils avancent jusqu'à *100 kilomètres* par an : l'invasion de mammifère la *plus rapide* jamais enregistrée."
  },
  {
   "id": "r10",
   "start": 53.511,
   "end": 56.908,
   "cap": "En *50 ans*, ils colonisent presque *tout le continent*."
  },
  {
   "id": "r11",
   "start": 57.608,
   "end": 62.688,
   "cap": "Alors, l'Australie tente un plan fou : une *clôture géante*."
  },
  {
   "id": "r12",
   "start": 63.088,
   "end": 69.396,
   "cap": "Entre *1901* et *1907*, trois clôtures sont construites, sur plus de *3 000 kilomètres*."
  },
  {
   "id": "r13",
   "start": 69.796,
   "end": 73.759,
   "cap": "Mais c'est *trop tard* : les lapins sont déjà passés de l'autre côté."
  },
  {
   "id": "r14",
   "start": 74.559,
   "end": 80.273,
   "cap": "En *1950*, on essaie une autre arme : un virus, la *myxomatose*."
  },
  {
   "id": "r15",
   "start": 80.723,
   "end": 85.063,
   "cap": "En deux ans, la population passe de *600 millions*… à *100 millions*."
  },
  {
   "id": "r16",
   "start": 85.513,
   "end": 89.453,
   "cap": "Mais les survivants deviennent *résistants*… et les lapins *reviennent*."
  },
  {
   "id": "r17",
   "start": 89.953,
   "end": 93.249,
   "cap": "Aujourd'hui, ils occupent *70 %* du pays."
  },
  {
   "id": "r18",
   "start": 93.949,
   "end": 97.187,
   "cap": "Tout ça… à cause de *24 lapins*."
  },
  {
   "id": "r19",
   "start": 98.087,
   "end": 105.994,
   "cap": "Et toi, tu connais d'autres animaux qui ont envahi un pays ? Dis-le en commentaire !"
  }
 ],
