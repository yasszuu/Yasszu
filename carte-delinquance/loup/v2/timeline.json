{
 "vo": [
  {
   "id": "h1",
   "start": 1.6,
   "end": 7.316,
   "cap": "En *novembre 1992*, un couple de loups est aperçu dans les *Alpes françaises*."
  },
  {
   "id": "h2",
   "start": 7.516,
   "end": 10.337,
   "cap": "Trente ans plus tard, ils sont *plus de 1 000*."
  },
  {
   "id": "h3",
   "start": 10.587,
   "end": 12.311,
   "cap": "Voici leur *incroyable retour*."
  },
  {
   "id": "a1",
   "start": 12.811,
   "end": 16.774,
   "cap": "Au *XVIIIe siècle*, le loup vivait sur presque *tout le territoire*."
  },
  {
   "id": "a2",
   "start": 16.924,
   "end": 21.591,
   "cap": "Mais *traqué*, *piégé*, *empoisonné*… il recule partout."
  },
  {
   "id": "a3",
   "start": 21.691,
   "end": 25.146,
   "cap": "Et il *disparaît* de France dans les *années 1930*."
  },
  {
   "id": "b1",
   "start": 25.746,
   "end": 30.471,
   "cap": "Il ne survit plus qu'en *Italie* : à peine *une centaine*, cachés dans les *Apennins*."
  },
  {
   "id": "b2",
   "start": 30.721,
   "end": 34.632,
   "cap": "*Protégés* à partir de *1971*, ils se multiplient..."
  },
  {
   "id": "b3",
   "start": 34.732,
   "end": 38.483,
   "cap": "et remontent vers le *nord*, de montagne en montagne."
  },
  {
   "id": "c1",
   "start": 38.983,
   "end": 42.177,
   "cap": "Jusqu'au *5 novembre 1992*."
  },
  {
   "id": "c2",
   "start": 42.777,
   "end": 45.618,
   "cap": "Ils sont repérés dans le parc du *Mercantour*."
  },
  {
   "id": "c3",
   "start": 45.918,
   "end": 48.481,
   "cap": "Personne ne les a réintroduits : ils sont *revenus seuls*."
  },
  {
   "id": "d1",
   "start": 48.981,
   "end": 50.458,
   "cap": "Ensuite, *tout s'accélère*."
  },
  {
   "id": "d2",
   "start": 50.658,
   "end": 52.827,
   "cap": "Le *Massif central* en *1997*."
  },
  {
   "id": "d3",
   "start": 53.027,
   "end": 54.961,
   "cap": "Les *Pyrénées* en *1999*."
  },
  {
   "id": "d4",
   "start": 55.161,
   "end": 56.803,
   "cap": "Puis le *Jura* en *2003*."
  },
  {
   "id": "d5",
   "start": 57.003,
   "end": 58.362,
   "cap": "Et enfin, les *Vosges*."
  },
  {
   "id": "d6",
   "start": 58.712,
   "end": 62.897,
   "cap": "Aujourd'hui, il est signalé jusqu'en *Bretagne*… et en *Normandie* !"
  },
  {
   "id": "e1",
   "start": 63.347,
   "end": 70.515,
   "cap": "En 2025, l'OFB estime leur nombre à environ *1 080 loups*."
  },
  {
   "id": "f1",
   "start": 71.115,
   "end": 76.15,
   "cap": "Mais ce retour a un prix : environ *12 000 animaux d'élevage* tués en un an."
  },
  {
   "id": "f2",
   "start": 76.5,
   "end": 80.946,
   "cap": "Et en 2025, l'Europe a *abaissé sa protection*."
  },
  {
   "id": "g1",
   "start": 81.946,
   "end": 85.085,
   "cap": "Alors, le loup a-t-il *sa place en France* ?"
  },
  {
   "id": "g2",
   "start": 85.435,
   "end": 90.948,
   "cap": "Dis-le en commentaire ! Prochain épisode : *le lion de l'Atlas*."
  }
 ],
