{
 "vo": [
  {
   "id": "l01",
   "start": 0.6,
   "end": 4.967,
   "cap": "On le disait le *plus grand lion du monde*… et il vivait au *Maroc*."
  },
  {
   "id": "l02",
   "start": 5.317,
   "end": 7.605,
   "cap": "Voici l'histoire du *lion de l'Atlas*."
  },
  {
   "id": "l03",
   "start": 8.305,
   "end": 14.31,
   "cap": "Il y a *2 000 ans*, il régnait sur toute l'*Afrique du Nord*, du Maroc jusqu'à l'Égypte."
  },
  {
   "id": "l04",
   "start": 14.91,
   "end": 21.657,
   "cap": "Sa *crinière sombre* descendait jusqu'au ventre, et les chasseurs parlaient de mâles de près de *300 kilos*."
  },
  {
   "id": "l05",
   "start": 22.357,
   "end": 26.74,
   "cap": "Mais les *Romains* en capturent des milliers, pour les jeux du *Colisée*."
  },
  {
   "id": "l06",
   "start": 27.34,
   "end": 34.593,
   "cap": "Puis, avec les *fusils* et les primes à la chasse, il recule jusque dans les montagnes de l'*Atlas*."
  },
  {
   "id": "l07",
   "start": 35.293,
   "end": 42.929,
   "cap": "En *1925*, depuis un avion, un photographe capture l'une des *dernières images* d'un lion sauvage."
  },
  {
   "id": "l08",
   "start": 43.429,
   "end": 49.369,
   "cap": "Et en *1942*, le *dernier lion connu* est abattu près du col du *Tizi n'Tichka*."
  },
  {
   "id": "l09",
   "start": 49.969,
   "end": 52.785,
   "cap": "Le lion de l'Atlas a *disparu de la nature*."
  },
  {
   "id": "l10",
   "start": 53.685,
   "end": 56.172,
   "cap": "Pourtant… l'histoire *ne s'arrête pas là*."
  },
  {
   "id": "l11",
   "start": 56.872,
   "end": 61.059,
   "cap": "Pendant des siècles, les tribus offraient des lions aux *sultans du Maroc*."
  },
  {
   "id": "l12",
   "start": 61.409,
   "end": 64.133,
   "cap": "Et la *ménagerie royale* les a gardés… jusqu'à aujourd'hui."
  },
  {
   "id": "l13",
   "start": 64.733,
   "end": 70.938,
   "cap": "Leurs descendants vivent au *zoo de Rabat*, qui abrite le plus grand groupe de lions de l'Atlas au monde."
  },
  {
   "id": "l14",
   "start": 71.438,
   "end": 75.41,
   "cap": "Dans tous les zoos de la planète, ils sont *moins d'une centaine*."
  },
  {
   "id": "l15",
   "start": 75.86,
   "end": 81.65,
   "cap": "Et même si leur *pureté génétique* fait débat, ils sont le dernier lien avec ce lion légendaire."
  },
  {
   "id": "l16",
   "start": 82.35,
   "end": 88.388,
   "cap": "En *2025*, *quatre lionceaux* de l'Atlas sont nés dans un zoo, en *Tchéquie*…"
  },
  {
   "id": "l17",
   "start": 88.688,
   "end": 91.69,
   "cap": "et on parle même de les *réintroduire* un jour au *Maroc* !"
  },
  {
   "id": "l18",
   "start": 92.39,
   "end": 99.274,
   "cap": "Aujourd'hui, il reste le *symbole du pays*… au point de donner son nom à l'*équipe nationale* de football."
  },
  {
   "id": "l19",
   "start": 100.174,
   "end": 104.704,
   "cap": "Alors… est-ce que tu aimerais le revoir rugir dans les montagnes de l'Atlas ?"
  },
  {
   "id": "l20",
   "start": 105.054,
   "end": 109.643,
   "cap": "Dis-le en commentaire ! Et abonne-toi pour ne pas rater le prochain épisode."
  }
 ],
