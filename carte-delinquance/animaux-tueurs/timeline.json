{
 "vo": [
  {
   "id": "t1",
   "start": 1.3,
   "end": 5.598,
   "cap": "Quel animal tue le plus d'*humains* chaque année ? Et surtout… *où* ?"
  },
  {
   "id": "t2",
   "start": 6.398,
   "end": 10.486,
   "cap": "Numéro 5 : le *loup*. Quelques victimes, surtout en *Inde*."
  },
  {
   "id": "t3",
   "start": 11.286,
   "end": 15.737,
   "cap": "Numéro 4 : le *lion*. Environ *200*, surtout en *Tanzanie*."
  },
  {
   "id": "t4",
   "start": 16.537,
   "end": 21.524,
   "cap": "Numéro 3 : l'*hippopotame*. Près de *500*, dans les lacs et les fleuves d'*Afrique*."
  },
  {
   "id": "t5",
   "start": 22.324,
   "end": 28.172,
   "cap": "Numéro 2 : le *chien*, à cause de la *rage*. *59 000*, dont un tiers en *Inde*."
  },
  {
   "id": "t6",
   "start": 29.072,
   "end": 35.421,
   "cap": "Et numéro 1… le *moustique*. Plus de *700 000 morts* par an, surtout en *Afrique*, au *Nigeria* en tête !"
  },
  {
