{
 "vo": [
  {
   "id": "w01",
   "start": 1.7,
   "end": 5.625,
   "cap": "En *1944*, un ours a combattu dans l'*armée polonaise*."
  },
  {
   "id": "w02",
   "start": 6.075,
   "end": 9.6,
   "cap": "Il avait un *grade*, des *rations*… et il buvait de la *bière*."
  },
  {
   "id": "w03",
   "start": 10.05,
   "end": 13.628,
   "cap": "Voici l'incroyable histoire de *Wojtek*, l'ours soldat."
  },
  {
   "id": "w04",
   "start": 14.428,
   "end": 16.878,
   "cap": "Nous sommes en *1942*, en *Iran*."
  },
  {
   "id": "w05",
   "start": 17.328,
   "end": 22.506,
   "cap": "Des soldats polonais, libérés des *camps soviétiques*, traversent le pays pour rejoindre les *Alliés*."
  },
  {
   "id": "w06",
   "start": 22.956,
   "end": 30.986,
   "cap": "Près de *Hamadan*, ils croisent un jeune garçon qui porte un sac. Dedans : un *ourson brun*, dont la mère a été tuée par des chasseurs."
  },
  {
   "id": "w07",
   "start": 31.436,
   "end": 38.647,
   "cap": "Les soldats l'échangent contre des *conserves*, du *chocolat* et un *couteau*. Ils l'appellent *Wojtek* : « le guerrier joyeux »."
  },
  {
   "id": "w08",
   "start": 39.097,
   "end": 45.463,
   "cap": "Wojtek grandit avec eux. Il dort sous leurs tentes, *lutte* avec les soldats… et mange même leurs *cigarettes*."
  },
  {
   "id": "w09",
   "start": 46.063,
   "end": 51.402,
   "cap": "Avec son unité, il traverse l'*Irak*, la *Syrie*, la *Palestine*, puis l'*Égypte*."
  },
  {
   "id": "w10",
   "start": 52.002,
   "end": 58.136,
   "cap": "Mais en *1944*, l'armée doit embarquer pour l'*Italie*… et les animaux sont *interdits* sur les navires."
  },
  {
   "id": "w11",
   "start": 58.586,
   "end": 63.674,
   "cap": "Alors les soldats trouvent une solution : ils enrôlent officiellement Wojtek comme *soldat*."
  },
  {
   "id": "w12",
   "start": 64.374,
   "end": 69.775,
   "cap": "En *mai 1944*, c'est la bataille du *Mont-Cassin*, l'une des plus violentes de la guerre."
  },
  {
   "id": "w13",
   "start": 70.225,
   "end": 75.103,
   "cap": "Selon ses camarades, Wojtek aide à porter des *caisses d'obus* de près de *45 kilos*."
  },
  {
   "id": "w14",
   "start": 75.553,
   "end": 81.371,
   "cap": "Son unité en fait son *emblème* : un ours qui porte un obus. Il est même promu *caporal*."
  },
  {
   "id": "w15",
   "start": 82.171,
   "end": 85.448,
   "cap": "Après la guerre, Wojtek suit les soldats jusqu'en *Écosse*."
  },
  {
   "id": "w16",
   "start": 86.048,
   "end": 93.412,
   "cap": "En *1947*, il est confié au *zoo d'Édimbourg*. Ses anciens camarades viennent le voir… et lui lancent des *cigarettes*."
  },
  {
   "id": "w17",
   "start": 94.012,
   "end": 97.239,
   "cap": "Il y meurt en *1963*, à *21 ans*."
  },
  {
   "id": "w18",
   "start": 97.939,
   "end": 101.949,
   "cap": "Aujourd'hui, des *statues* de Wojtek se dressent en *Écosse* et en *Pologne*."
  },
  {
   "id": "w19",
   "start": 102.749,
   "end": 106.782,
   "cap": "Et toi, tu connais d'autres animaux devenus soldats ? Dis-le en commentaire !"
  }
 ],
